# Copy this file to .env (or add these in Vercel → Project → Settings → Environment Variables).

# Google OAuth "Web application" Client ID.
# Example: 1234567890-abc123def456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Optional YouTube Data API key (Google Cloud → Credentials → Create credentials → API key).
# Lets Search find YouTube songs without signing in. Without it, YouTube search works
# once the user has connected YouTube. Each search uses 100 of the 10,000 daily quota units.
VITE_YOUTUBE_API_KEY=

# Free Jamendo Client ID from https://devportal.jamendo.com (adds Jamendo to Search).
VITE_JAMENDO_CLIENT_ID=

# Optional: full link to the Android APK, for example a GitHub Release asset:
# https://github.com/hboxdev/music-app/releases/latest/download/tubetunes.apk
# Leave empty to use downloads/tubetunes.apk next to the website.
VITE_APK_URL=
